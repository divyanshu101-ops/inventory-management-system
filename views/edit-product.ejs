<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>

    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <div class="container">

        <h1>Edit Product</h1>

        <form action="/products/edit/<%= product.id %>" method="POST">

            <label for="name">Product Name</label>

            <input
                type="text"
                id="name"
                name="name"
                value="<%= product.name %>"
                required
            >

            <label for="description">Description</label>

            <textarea
                id="description"
                name="description"
                rows="4"
            ><%= product.description %></textarea>

            <label for="price">Price</label>

            <input
                type="number"
                step="0.01"
                id="price"
                name="price"
                value="<%= product.price %>"
                required
            >

            <label for="stock">Stock</label>

            <input
                type="number"
                id="stock"
                name="stock"
                value="<%= product.stock %>"
                required
            >

            <label for="category">Category</label>

            <select
                id="category"
                name="category_id"
            >

                <% categories.forEach(category => { %>

                    <option
                        value="<%= category.id %>"
                        <%= category.id === product.category_id ? "selected" : "" %>
                    >
                        <%= category.name %>
                    </option>

                <% }) %>

            </select>

            <button
                type="submit"
                class="btn add-btn"
            >
                Update Product
            </button>

        </form>

    </div>

</body>
</html>